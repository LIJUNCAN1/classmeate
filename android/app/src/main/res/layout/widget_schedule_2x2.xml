<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- 顶部状态行：星期几写中间左右可切换日期，右上角原子组件已去掉 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="课星球"
            android:textColor="#15803D"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_prev_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                android:text="‹"
                android:textColor="#15803D"
                android:textSize="16sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/widget_day_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="周五"
                android:textColor="#15803D"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_next_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                android:text="›"
                android:textColor="#15803D"
                android:textSize="16sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- 右上角原子组件按用户要求去掉，保持平衡占位 -->
        <View
            android:layout_width="32dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <!-- 中间：分段弧线进度图（按今天几节课分几段，底部开口80度） + 中心大字剩余课数 + 上浮放学时间，绝不遮挡文字 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="2dp">

        <!-- 分段弧线进度图底层绘制 -->
        <ImageView
            android:id="@+id/widget_arc_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="分段弧线进度图" />

        <!-- 环心数据信息：上浮对齐，确保与底部弧线开口留有充足空间，绝不遮挡文字 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal|center_vertical"
            android:paddingBottom="12dp">

            <!-- 中心：大字号醒目呈现今日剩余课程数 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/widget_count_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textColor="#0F172A"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_count_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="4dp"
                    android:text="节剩余"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- 正下方：清晰标注放学时间（用户要求：去掉距放学还有多久，进度条不能遮挡文字） -->
            <TextView
                android:id="@+id/widget_dismissal_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:paddingHorizontal="6dp"
                android:text="17:40 放学"
                android:textColor="#16A34A"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:includeFontPadding="false" />
        </LinearLayout>
    </FrameLayout>

    <!-- 底部课程表列表：从左到右 课程名和地点，右边写还有多久上课，一次只显示两门，已结束的不显示 -->
    <LinearLayout
        android:id="@+id/widget_courses_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 课程 1 -->
        <LinearLayout
            android:id="@+id/widget_course_1_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3.5dp"
            android:layout_marginBottom="3dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_c1_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="给水排水管道工程"
                    android:textColor="#0F172A"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/widget_c1_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@长智楼 A208"
                    android:textColor="#64748B"
                    android:textSize="8sp"
                    android:singleLine="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_c1_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25分钟后 · 10:05"
                android:textColor="#15803D"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 课程 2 -->
        <LinearLayout
            android:id="@+id/widget_course_2_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3.5dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_c2_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="计算机系统结构"
                    android:textColor="#0F172A"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/widget_c2_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@信息实验楼 301"
                    android:textColor="#64748B"
                    android:textSize="8sp"
                    android:singleLine="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_c2_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4小时后 · 14:00"
                android:textColor="#15803D"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 暂无待上课程状态 -->
        <LinearLayout
            android:id="@+id/widget_course_empty_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日课程已全部结束 ✨"
                android:textColor="#15803D"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
